{
  "name": "hexo-pro-client",
  "version": "2.1.0-beta.1",
  "description": "hexo pro a backend plugin for hexo",
  "main": "index",
  "bin": {
    "hexo-pro-agent": "bin/hexo-pro-agent.js",
    "hexo-pro-mcp": "bin/hexo-pro-mcp.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "verify": "yarn typecheck && yarn test",
    "prebuild": "yarn typecheck",
    "start": "npm run dev",
    "dev": "yarn cross-env NODE_ENV=development webpack serve --config ./config/webpack.dev.js",
    "build": "cross-env NODE_ENV=production webpack --config ./config/webpack.prod.js",
    "build:desktop": "yarn build && cd hexo-pro-desktop && yarn copy-core && yarn build:electron",
    "dev:desktop": "yarn build && cd hexo-pro-desktop && yarn copy-core && yarn dev",
    "setup:desktop": "cd hexo-pro-desktop && yarn install && yarn copy-core",
    "agent:cli": "node bin/hexo-pro-agent.js",
    "agent:mcp": "node bin/hexo-pro-mcp.mjs",
    "test:agent": "node --test test/agent-client.test.js test/base-url-resolver.test.js test/mcp-token.test.js test/runtime-manager.test.js",
    "test:theme": "node --test test/theme-runtime.test.js",
    "test:editor": "node --test test/editor-*.test.js test/post-editor-save.test.js test/theme-preview.test.js",
    "test:identity": "node --test test/document-identity.test.js",
    "cleanup-db": "node scripts/cleanup-db.js",
    "lint": "eslint ./client/src/",
    "eslint": "eslint --fix ./client/src/ --ext .ts,.tsx,.js,.jsx --cache",
    "dev:mobile": "cross-env NODE_ENV=development webpack serve --config config/webpack.mobile.js --mode development",
    "build:mobile": "cross-env NODE_ENV=production webpack --config config/webpack.mobile.js --mode production",
    "mobile:sync": "yarn build:mobile && cap sync",
    "mobile:assets": "node scripts/mobile-assets.cjs",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "mobile:build:android": "node scripts/build-mobile.cjs android",
    "mobile:build:ios": "node scripts/build-mobile.cjs ios",
    "test:mobile": "node --test test/mobile-*.test.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ant-design/charts": "v1",
    "@ant-design/icons": "^5.3.7",
    "@blocknote/core": "0.55.0",
    "@blocknote/mantine": "0.55.0",
    "@blocknote/react": "0.55.0",
